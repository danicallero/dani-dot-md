---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { clamp, ogKey, ogUrl } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** Replaces the generated share image. Leave it out and the page gets its own card. */
  image?: string;
  type?: 'website' | 'article';
  /** Articles only. */
  published?: Date;
  tags?: string[];
  noindex?: boolean;
  /** Extra schema.org nodes for this page, added to the site-wide graph. */
  jsonLd?: Record<string, unknown>[];
}

const { title, description = site.description, image, type = 'website', published, tags = [], noindex = false, jsonLd = [] } = Astro.props;

// <title> keeps the site name unless the page title is already long.
const pageTitle = title ?? site.name;
const fullTitle = title && title.length <= 52 ? `${title} · ${site.domain}` : title ? title : `${site.name} · ${site.domain}`;
const metaDescription = clamp(description, 160);
const socialDescription = clamp(description, 200);
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = image
  ? new URL(image, site.url).href
  : noindex
    ? new URL('/og-image.png', site.url).href
    : ogUrl(ogKey(Astro.url.pathname));

const personId = `${site.url}/#person`;
const websiteId = `${site.url}/#website`;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: site.name,
      alternateName: [site.short, 'danicallero'],
      url: site.url,
      email: site.email,
      image: new URL('/portrait.jpg', site.url).href,
      jobTitle: site.role,
      homeLocation: { '@type': 'Place', name: site.location },
      sameAs: site.profiles,
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: site.url,
      name: site.domain,
      description: site.description,
      inLanguage: 'en',
      publisher: { '@id': personId },
    },
    ...jsonLd,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content={site.name} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.domain} blog`} href="/rss.xml" />
    <link rel="me" href="https://github.com/danicallero" />

    <meta property="og:site_name" content={site.domain} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={type} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    {type === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={new URL('/about/', site.url).href} />}
    {type === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.handle} />
    <meta name="twitter:creator" content={site.handle} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const current = root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });

      // Only animate shared images that are actually on screen. One scrolled out of
      // view would otherwise fly in from nowhere.
      window.addEventListener('pageswap', (event) => {
        if (!(event as Event & { viewTransition?: unknown }).viewTransition) return;
        document.querySelectorAll<HTMLElement>('[style*="view-transition-name"]').forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.bottom < 0 || r.top > innerHeight || r.right < 0 || r.left > innerWidth) el.style.viewTransitionName = 'none';
        });
      });
    </script>
  </body>
</html>
