---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import ArticleLightbox from '../../components/ArticleLightbox.astro';
import { inline } from '../../lib/inline';
import type { Block } from '../../data/projects';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import sharp from 'sharp';
import { projects } from '../../data/projects';
import { breadcrumbs, ogKey, ogUrl } from '../../lib/seo';
import { site } from '../../data/site';

export function getStaticPaths() {
  const sorted = [...projects].sort((a, b) => b.year - a.year);
  return sorted.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, prev: sorted[i - 1], next: sorted[i + 1] },
  }));
}

const { project, prev, next } = Astro.props;

// Pictures keep their size on the page, and tall ones (phones) sit beside the text.
const sizeOf = async (src: string) => {
  try {
    const { width = 0, height = 0 } = await sharp(await readFile(join(process.cwd(), 'public', src))).metadata();
    return { width, height };
  } catch {
    return { width: 0, height: 0 };
  }
};
type Sized = Block & { width?: number; height?: number };
const sections: { label: string; blocks: Sized[] }[] = await Promise.all(
  (project.sections ?? []).map(async (s) => ({
    label: s.label,
    blocks: await Promise.all(s.blocks.map(async (b): Promise<Sized> => (b.type === 'figure' ? { ...b, ...(await sizeOf(b.src)) } : b))),
  })),
);
const host = (u: string) => new URL(u).host.replace(/^www\./, '');
const path = `/projects/${project.slug}/`;
const url = new URL(path, site.url).href;
const jsonLd = [
  {
    '@type': project.github ? 'SoftwareSourceCode' : 'CreativeWork',
    '@id': `${url}#project`,
    name: project.title,
    description: project.description,
    url,
    image: ogUrl(ogKey(path)),
    dateCreated: String(project.year),
    keywords: project.tags.join(', '),
    inLanguage: 'en',
    author: { '@id': `${site.url}/#person` },
    isPartOf: { '@id': `${site.url}/#website` },
    ...(project.github ? { codeRepository: project.github } : {}),
    ...(project.url ? { sameAs: [project.url] } : {}),
  },
  breadcrumbs([
    ['Home', '/'],
    ['Projects', '/projects/'],
    [project.title, path],
  ]),
];
---

<BaseLayout title={project.title} description={project.description} jsonLd={jsonLd}>
  <div class="container" data-article>
    <header class="page-head">
      <a class="crumb caps" href="/projects/">← Projects</a>
      <h1 class="display">{project.title}</h1>
      <p class="page-lead">{project.description}</p>
      <ul class="tags">
        {project.tags.map((t) => <li class="tag">{t}</li>)}
      </ul>
    </header>

    {project.gallery && project.gallery.length > 0 && <Gallery items={project.gallery} variant="strip" standalone={false} transitionName={`entry-${project.slug}`} />}

    <dl class="meta-grid">
      <div><dt>Year</dt><dd>{project.year}</dd></div>
      {project.github && <div><dt>Source</dt><dd><a class="inline-link" href={project.github} rel="noopener noreferrer" target="_blank">{host(project.github)}{new URL(project.github).pathname}</a></dd></div>}
      {project.url && <div><dt>Live</dt><dd><a class="inline-link" href={project.url} rel="noopener noreferrer" target="_blank">{host(project.url)}</a></dd></div>}
    </dl>

    <section class="section row compact">
      <h2 class="label">Overview</h2>
      <div class="prose flow">
        {project.longDescription.split(/\n\n+/).map((para) => <p set:html={inline(para)} />)}
        {
          project.highlights.length > 0 && (
            <aside class="details">
              <h3 class="side-label">Details</h3>
              <ul class="dash-list">
                {project.highlights.map((h) => <li>{h}</li>)}
              </ul>
            </aside>
          )
        }
      </div>
    </section>

    {
      sections.map((section) => (
        <section class="section row compact">
          <h2 class="label">{section.label}</h2>
          <div class="prose flow">
            {section.blocks.map((block) =>
              block.type === 'p' ? (
                <p set:html={inline(block.text)} />
              ) : block.type === 'list' ? (
                <ul class="dash-list">
                  {block.items.map((item) => (
                    <li set:html={inline(item)} />
                  ))}
                </ul>
              ) : (
                <figure class:list={{ plain: block.plain, portrait: (block.height ?? 0) > (block.width ?? 0) * 1.2 }}>
                  <img src={block.src} alt={block.alt} width={block.width || undefined} height={block.height || undefined} loading="lazy" />
                  <figcaption>{block.caption}</figcaption>
                </figure>
              ),
            )}
          </div>
        </section>
      ))
    }

    {
      project.videoEmbedUrl && (
        <section class="section">
          <h2 class="label">Demo</h2>
          <div style="aspect-ratio:16/9;max-width:56rem">
            <iframe src={project.videoEmbedUrl} title={`${project.title} demo`} style="width:100%;height:100%;border:0" loading="lazy" allowfullscreen />
          </div>
        </section>
      )
    }


    <nav class="pager" aria-label="More projects">
      {prev ? <a href={`/projects/${prev.slug}/`}><span class="meta">← Newer</span><span class="title">{prev.title}</span></a> : <span />}
      {next ? <a class="next" href={`/projects/${next.slug}/`}><span class="meta">Older →</span><span class="title">{next.title}</span></a> : <span />}
    </nav>
  </div>
  <ArticleLightbox />
</BaseLayout>
