---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryList from '../../components/EntryList.astro';
import { publishedPosts } from '../../lib/posts';
import { shortDate } from '../../lib/dates';
const posts = (await publishedPosts()).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const fmt = shortDate;
---

<BaseLayout title="Blog" description="Notes on events and software, by Daniel Callero Costales.">
  <div class="container">
    <header class="page-head">
      <h1 class="display">Blog</h1>
      <p class="page-lead">Notes on events and software. <a class="inline-link" href="/rss.xml">RSS</a></p>
    </header>
    <div style="margin-bottom:var(--s5)"><EntryList items={posts.map((p) => ({ href: `/blog/${p.id}`, title: p.data.title, name: p.id, desc: p.data.description, tags: p.data.tags, meta: fmt(p.data.date), image: p.data.gallery?.find((g) => g.type === 'image')?.src }))} /></div>
  </div>
</BaseLayout>
