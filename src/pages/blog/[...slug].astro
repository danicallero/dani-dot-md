---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import ArticleLightbox from '../../components/ArticleLightbox.astro';
import { breadcrumbs, ogKey, ogUrl } from '../../lib/seo';
import { site } from '../../data/site';
import { render } from 'astro:content';
import { publishedPosts } from '../../lib/posts';
import { longDate } from '../../lib/dates';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags, gallery } = post.data;
const fmt = longDate(date);
const url = new URL(`/blog/${post.id}/`, site.url).href;
const jsonLd = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#post`,
    headline: title,
    description,
    datePublished: date.toISOString(),
    dateModified: date.toISOString(),
    url,
    mainEntityOfPage: url,
    image: ogUrl(ogKey(`/blog/${post.id}/`)),
    keywords: tags.join(', '),
    inLanguage: 'en',
    author: { '@id': `${site.url}/#person` },
    publisher: { '@id': `${site.url}/#person` },
    isPartOf: { '@id': `${site.url}/#website` },
  },
  breadcrumbs([
    ['Home', '/'],
    ['Blog', '/blog/'],
    [title, `/blog/${post.id}/`],
  ]),
];
---

<BaseLayout title={title} description={description} type="article" published={date} tags={tags} jsonLd={jsonLd}>
  <div class="container" data-article>
    <header class="article page-head">
      <a class="crumb caps" href="/blog">← Blog</a>
      <h1 class="display">{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{fmt}</time>
      </p>
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((t) => <li class="tag">{t}</li>)}
          </ul>
        )
      }
    </header>
    {gallery && gallery.length > 0 && <Gallery items={gallery} variant="strip" standalone={false} transitionName={`entry-${post.id}`} />}
    <article class="article">
      <div class="prose">
        <Content />
      </div>
      <p class="section-foot" style="margin-bottom:var(--s5)"><a class="line-link" href="/blog">All posts</a></p>
    </article>
  </div>
  <ArticleLightbox />
</BaseLayout>
