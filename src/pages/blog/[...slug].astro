---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import ArticleLightbox from '../../components/ArticleLightbox.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags, gallery } = post.data;
const fmt = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={title} description={description} type="article" image={gallery?.[0]?.src}>
  <div class="container" data-article>
    <header class="article page-head">
      <a class="crumb caps" href="/blog">← Writing</a>
      <h1 class="display">{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{fmt}</time>
      </p>
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((t) => <li class="tag">{t}</li>)}
          </ul>
        )
      }
    </header>
    {gallery && gallery.length > 0 && <Gallery items={gallery} variant="strip" standalone={false} transitionName={`entry-${post.id}`} />}
    <article class="article">
      <div class="prose">
        <Content />
      </div>
      <p class="section-foot" style="margin-bottom:var(--s5)"><a class="line-link" href="/blog">All writing</a></p>
    </article>
  </div>
  <ArticleLightbox />
</BaseLayout>
