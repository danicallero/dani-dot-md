---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import EntryList from '../components/EntryList.astro';
import { projects, coverOf } from '../data/projects';
import { site, links } from '../data/site';

const featured = projects.filter((p) => p.featured);
const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---

<BaseLayout>
  <div class="container">
    <section class="hero">
      <div>
        <p class="kicker">{site.location}</p>
        <h1 class="display">Daniel Callero Costales</h1>
        <p class="hero-sub">
          Computer Science student at the Universidade da Coruña. I build web and mobile apps, mostly for GPUL and HackUDC.
        </p>
        <p class="prose" style="max-width:52ch">
          Co-director of <a href="https://hackudc.com" rel="noopener">HackUDC</a> 2027, with <a href="https://gpul.org" rel="noopener">GPUL</a>.
        </p>
        <div class="hero-actions">
          <a class="line-link" href="/projects">Projects</a>
          <a class="line-link" href="/blog">Writing</a>
          <a class="line-link" href="#contact">Contact</a>
        </div>
      </div>
      <figure class="hero-photo">
        <img src="/portrait.jpg" alt="Portrait of Daniel Callero" width="444" height="444" style="view-transition-name: portrait; view-transition-class: entry" />
        <figcaption class="meta">Dani, A Coruña</figcaption>
      </figure>
    </section>

    <section class="section" id="projects">
      <h2 class="label">Selected projects</h2>
      <EntryList items={featured.map((p) => ({ href: `/projects/${p.slug}`, title: p.title, name: p.slug, desc: p.description, kicker: p.tags.join(' · '), meta: String(p.year), image: coverOf(p) }))} />
      <p class="section-foot"><a class="line-link" href="/projects">All projects</a></p>
    </section>

    {
      posts.length > 0 && (
        <section class="section" id="writing">
          <h2 class="label">Writing</h2>
          <EntryList items={posts.map((p) => ({ href: `/blog/${p.id}`, title: p.data.title, name: p.id, desc: p.data.description, kicker: p.data.tags.join(' · '), meta: fmt(p.data.date), image: p.data.gallery?.find((g) => g.type === 'image')?.src }))} />
          <p class="section-foot"><a class="line-link" href="/blog">All writing</a></p>
        </section>
      )
    }

    <section class="section" id="contact">
      <h2 class="label">Contact</h2>
      <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
      <div class="contact-links">
        {links.map((l) => <a class="line-link" href={l.href} rel="noopener noreferrer" target="_blank">{l.label}</a>)}
      </div>
    </section>
  </div>
</BaseLayout>
