---
interface Props {
  id?: string;
}
const { id } = Astro.props;
---

<dialog class="lightbox" aria-label="Media viewer" id={id} tabindex="-1">
  <div class="lightbox-bar">
    <span class="meta" data-counter></span>
    <button class="lightbox-close" type="button" data-close>Close</button>
  </div>
  <div class="lightbox-stage" data-stage>
    <button class="lightbox-nav prev" type="button" data-prev aria-label="Previous">←</button>
    <button class="lightbox-nav next" type="button" data-next aria-label="Next">→</button>
  </div>
  <p class="lightbox-caption meta" data-caption></p>
</dialog>
