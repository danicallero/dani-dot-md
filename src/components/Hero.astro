---
import { Icon } from 'astro-icon/components';
import type { heroCopy, socialLinks } from '../data/site';
interface Props { copy: typeof heroCopy; links: typeof socialLinks; }
const { copy, links } = Astro.props;
---

<section class="hero-stage" aria-labelledby="hero-title">
  <div class="hero-surface" data-interactive="false" data-hover="false">
    <div class="hero-layer hero-base">
      <div class="hero-content">
        <h1 id="hero-title">{copy.title}</h1>
        <p class="hero-tagline">{copy.tagline}</p>
        <ul class="link-list" aria-label="Primary links">
          {links.map(({ label, href, icon }) => (
            <li><a class="link-pill" href={href} aria-label={label} data-label={label} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noreferrer' : undefined}><Icon name={icon} size="19" aria-hidden="true" /></a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="hero-layer hero-invert" aria-hidden="true">
      <div class="hero-content">
        <h2>{copy.invertTitle}</h2>
        <p class="hero-tagline">{copy.invertTagline}</p>
        <ul class="link-list">{links.map(({ icon }) => <li><span class="link-pill"><Icon name={icon} size="19" /></span></li>)}</ul>
      </div>
    </div>
  </div>
</section>
